# ---------------------------------------------------------------------------
# Neon Postgres. Use the *pooled* connection string from the Neon dashboard
# (the host contains "-pooler"). Must include ?sslmode=require.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Secret used to sign session JWTs (HS256). Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET="replace-me-with-at-least-32-random-characters"

# ---------------------------------------------------------------------------
# Optional: product image uploads. Without this the image field accepts a URL
# but direct file upload returns 501. Get it from Vercel > Storage > Blob.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""
